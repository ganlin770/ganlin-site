<footer>
  <span class="brand"><span class="dot" aria-hidden="true"></span>GAN LIN</span>
  <span>© 2026 — Designed &amp; built with WebGL. Cream field × refractive thin-film glass, hand-written shaders.</span>
</footer>

<script>
/* mark JS available so hidden reveal state only applies when JS can un-hide it */
document.documentElement.classList.add('js');
var RM = matchMedia('(prefers-reduced-motion: reduce)');

/* ============ WebGL cream-orb: light field + single-refraction thin-film glass ============ */
(function(){
  const canvas = document.getElementById('gl');
  const gl = canvas.getContext('webgl', {antialias:false, alpha:false, powerPreference:'default'});
  if(!gl){
    document.documentElement.style.background='radial-gradient(120% 120% at 60% 0%, #fbfaf4, #efede7)';
    canvas.style.display='none'; return;
  }

  const vsrc = `attribute vec2 p; void main(){ gl_Position = vec4(p,0.0,1.0); }`;
  const fsrc = `
precision highp float;

uniform vec2  uRes;        // drawingbuffer px (canvas.width, canvas.height)
uniform float uTime;       // seconds
uniform vec2  uMouse;      // 0..1, y up
uniform float uScroll;     // 0 hero .. 1 content risen
uniform float uReduce;     // 1 animate, 0 reduced-motion (freezes temporal terms)
uniform float uQuality;    // 1 full, 0 lite (drops the caustic colour)
uniform float uLeftBias;   // 1 desktop (protect left headline), 0 mobile
uniform float uGlassDisp;  // refraction displacement (~0.16 thin .. ~0.24 chunky)
uniform float uDispSpread; // per-channel film wavelength split (~0.06)
uniform float uRimStr;     // thin-film visibility (~1.0)
uniform float uMobile;     // 1 portrait/small (shrink + recenter orb), 0 otherwise

/* ---- cream palette (sampled from haoqi.design) ---- */
const vec3 CREAM   = vec3(0.984,0.980,0.957); // #fbfaf4
const vec3 GREIGE  = vec3(0.937,0.929,0.906); // #efede7
const vec3 INK     = vec3(0.098,0.106,0.106); // #191b1b
/* soft pastel spectrum */
const vec3 MINT    = vec3(0.502,0.855,0.675); // #80daac
const vec3 SKY     = vec3(0.553,0.796,1.000); // #8dcbff
const vec3 PERI    = vec3(0.686,0.714,1.000); // #afb6ff
const vec3 CORAL   = vec3(1.000,0.639,0.639); // #ffa3a3
const vec3 GOLD    = vec3(0.922,0.776,0.412); // #ebc669
const vec3 INDIGO  = vec3(0.369,0.325,0.890); // #5e53e3

float hash(vec2 p){ p=fract(p*vec2(123.34,345.45)); p+=dot(p,p+34.345); return fract(p.x*p.y); }
float ign(vec2 p){ return fract(52.9829189*fract(dot(p,vec2(0.06711056,0.00583715)))); }
float noise(vec2 p){
  vec2 i=floor(p), f=fract(p);
  vec2 u=f*f*(3.0-2.0*f);
  float a=hash(i), b=hash(i+vec2(1.0,0.0)),
        c=hash(i+vec2(0.0,1.0)), d=hash(i+vec2(1.0,1.0));
  return mix(mix(a,b,u.x), mix(c,d,u.x), u.y);
}
/* 2-octave fbm — the ONLY noise the background ever pays for */
float fbm2(vec2 p){
  float v=0.0, a=0.6;
  mat2 m=mat2(1.6,1.2,-1.2,1.6);
  v+=a*noise(p); p=m*p; a*=0.5;
  v+=a*noise(p);
  return v;
}
/* 3-octave fbm — used ONCE, only inside the glass for the caustic + film thickness */
float fbm3(vec2 p){
  float v=0.0, a=0.6;
  mat2 m=mat2(1.6,1.2,-1.2,1.6);
  v+=a*noise(p); p=m*p; a*=0.5;
  v+=a*noise(p); p=m*p; a*=0.5;
  v+=a*noise(p);
  return v*1.1;
}

/* =========================================================================
   bgField(): the haoqi SKY — cream floor rising to a pale-blue zenith with
   soft white cloud lumps + ONE analytic diagonal light shaft.
   STILL EXACTLY ONE fbm2 EVALUATION — n is reused for clouds, grain, tint.
   uv is aspect-corrected, y-up (uv.y = -1 bottom .. +1 top), so the orb's
   refracted taps sample this same sky and the glass genuinely bends clouds.
   ========================================================================= */
vec3 bgField(vec2 uv){
  float t = uTime*0.02*uReduce;
  /* the ONE noise eval — slow sideways drift reads as cloud movement */
  float n = fbm2(uv*0.85 + vec2(1.6*t, 0.3*t));

  /* vertical ramp: cream ground -> pale sky-blue wash -> soft zenith */
  float skyAmt  = smoothstep(-0.55, 0.85, uv.y);
  vec3  skyPale = vec3(0.75, 0.84, 0.96);
  vec3  skyDeep = vec3(0.663, 0.788, 0.933);   /* #a9c9ee, sampled from ref */
  vec3  col = mix(CREAM, skyPale, skyAmt*0.9);
  col = mix(col, skyDeep, smoothstep(0.45, 1.05, uv.y)*0.6);

  /* old editorial pastel mottle survives ONLY on the cream floor */
  vec3 cool = mix(SKY, PERI, 0.5);
  vec3 warm = mix(GOLD, CORAL, 0.5);
  vec3 tint = mix(warm, cool, smoothstep(0.30, 0.72, n));
  col = mix(col, tint, 0.10*(1.0 - skyAmt)*smoothstep(0.10,0.95,n));

  /* cloud lumps: threshold the SAME n into rounded bright-white masses */
  float cloud = smoothstep(0.52, 0.80, n);
  cloud = cloud*cloud*(3.0 - 2.0*cloud);       /* rounder shoulders */
  col = mix(col, vec3(0.995, 0.998, 1.0), cloud*(0.12 + 0.55*skyAmt));

  /* one analytic diagonal light shaft — rotated coord, ZERO noise evals */
  float sc   = dot(uv, vec2(0.83, 0.56));      /* ~34deg beam axis */
  float beam = smoothstep(0.55, 0.95, 0.5 + 0.5*sin(sc*3.0 - t*4.0));
  col += beam * skyAmt * (0.65 + 0.35*cloud) * vec3(0.055, 0.050, 0.040);

  /* greige grounding kept in the LOWER field only — scrim handoff stays cream */
  float ground = smoothstep(0.15, 1.4, dot(uv,uv)) * smoothstep(0.55, -0.35, uv.y);
  col = mix(col, GREIGE, ground*0.55);

  col *= 0.985 + 0.03*n;                       /* micro-lum grain, unchanged */
  return col;
}

/* -------------------------------------------------------------------------
   thinFilm(): RGB interference colour from an optical path difference.
   Cheap 3-cosine spectral reconstruction — NO field eval, NO texture.
   Pre-biased into the locked iridescent palette so it tints, never reads
   as pure RGB neon.
   ------------------------------------------------------------------------- */
vec3 thinFilm(float opd, float spread){
  vec3 ph = 6.2831853 * (opd + vec3(-spread, 0.0, spread));
  vec3 c  = 0.5 + 0.5*cos(ph);
  vec3 lo = mix(SKY,  PERI, 0.5);   // cool trough
  vec3 hi = mix(mix(GOLD, CORAL, 0.5), SKY, 0.16); // warm crest, nudged cooler for the sky
  vec3 spectral = mix(lo, hi, c.gbr*0.5 + c.rgb*0.5);
  spectral = mix(spectral, MINT, c.g*c.g*0.25); // oil-slick green band
  return spectral;
}

void main(){
  vec2 frag = gl_FragCoord.xy;
  vec2 uv   = (frag*2.0 - uRes)/uRes.y;   // aspect-correct, y up, center 0
  vec2 px   = frag/uRes;                   // 0..1 screen
  vec2 m    = (uMouse*2.0 - 1.0); m.x *= uRes.x/uRes.y;

  /* ---------- BACKGROUND: one and only one field eval outside the orb ---------- */
  vec3 col = bgField(uv);

  /* ---------- orb geometry (haoqi asymmetry: parked right, gentle drift) ---------- */
  float engage  = smoothstep(0.05, 0.40, length(m));
  float idle    = 1.0 - engage;
  vec2  floatOff= vec2(sin(uTime*0.42), sin(uTime*0.33+1.7))*0.016*idle*uReduce;
  float breathe = 1.0 + 0.010*sin(uTime*0.5)*idle*uReduce;

  /* desktop: pushed right + slightly up so it clears the left headline;
     mobile/portrait: recentered + shrunk so it stops oversizing off-edge. */
  vec2  ctrBase = mix(vec2(0.72, 0.06), vec2(0.12, -0.02), uMobile);
  float Rbase   = mix(0.58, 0.42, uMobile);
  vec2  ctr = ctrBase + m*0.10 + floatOff;
  float R   = Rbase*breathe*(1.0 - 0.08*uScroll);
  vec2  pp  = uv - ctr;
  float d   = length(pp);

  /* ===== SOFT CONTACT SHADOW + AO (0 field taps, background only) ===== */
  vec2  sp = pp - vec2(0.0, -0.10);
  float sd = length(vec2(sp.x*0.85, sp.y*1.25));
  float shadow = smoothstep(R*1.55, R*0.55, sd);
  float aoRing = smoothstep(R*1.20, R, d) * (1.0 - smoothstep(R, R*1.20, d));
  float ground = clamp(shadow*0.20 + aoRing*0.16, 0.0, 0.28);
  ground *= step(R, d) * (1.0 - 0.45*uScroll);
  col = mix(col, col*GREIGE/CREAM, ground);   // shadow leans greige, not neutral grey

  if(d < R){
    float z = sqrt(max(R*R - d*d, 0.0)) / R;        // 0 rim .. 1 centre
    vec3  nrm = vec3(pp/R, z);
    nrm += vec3(m*0.14*(1.0 - z*0.5), 0.0);
    nrm  = nrm * inversesqrt(max(dot(nrm,nrm), 1e-8));
    vec3  V   = vec3(0.0, 0.0, 1.0);
    float ndv = max(dot(nrm, V), 0.0);

    float fres = pow(1.0 - ndv, 4.0);
    float thin = 1.0 - z;

    /* ===== SINGLE refraction + 3-tap chromatic dispersion w/ true lens magnification =====
       interior fbm ledger: 1 outer bgField + 3 taps + 1 fbm3 = 5 (<= budget). */
    float rr      = d/R;                              // 0 centre .. 1 rim
    float lens    = mix(0.55, 1.18, smoothstep(0.0,1.0, rr*rr)); // centre magnifies inward, rim expands/inverts
    float dispMag = uGlassDisp * (0.75 + 0.95*thin);
    vec3  glass = vec3(0.0);
    vec3  wsum  = vec3(0.0);
    for(int i=0;i<3;i++){
      float f   = float(i)/2.0;
      float ior = mix(1.45, 1.60, f) + f*uDispSpread;
      float eta = 1.0/ior;
      vec3  r1  = refract(-V, nrm, eta);
      if(dot(r1,r1) < 1e-5) r1 = reflect(-V, nrm);   // TIR guard
      r1 = r1 * inversesqrt(max(dot(r1,r1), 1e-8));
      vec2 baseUV = ctr + pp*lens;                    // lens magnification (refraction made VISIBLE)
      vec2 suv    = baseUV + r1.xy*dispMag*(0.6 + 0.8*rr); // chromatic split rides the rim
      vec3 s   = bgField(suv);
      vec3 tint;
      if(i==0)      tint = mix(MINT, SKY, 0.35); // cooler first tap under a blue sky
      else if(i==1) tint = SKY;
      else          tint = PERI;
      vec3 wsp = mix(vec3(1.0), tint, (0.32 + 0.65*fres));
      glass += s * wsp;
      wsum  += wsp;
    }
    glass /= max(wsum, vec3(0.001));

    /* ===== Beer-Lambert depth: thin clear rim, denser cool core, faint warm pool ===== */
    float path = 0.35 + 0.65*z;
    glass *= mix(vec3(1.0), vec3(0.88,0.92,0.99), path);
    glass = mix(glass, glass*0.93, smoothstep(0.2,1.0,z)*0.5);
    glass += mix(GOLD, CREAM, 0.5) * pow(z, 3.0) * 0.04;

    /* ===== ONE caustic fbm3 — reuse its scalar to perturb film thickness =====
       lite path still computes fbm3 once so the iridescence keeps its swirl. */
    float filmMod = 0.0;
    {
      vec2 iuv = nrm.xy*2.2 + vec2(uTime*0.05, -uTime*0.04)*uReduce;
      float c = fbm3(iuv);                 // the ONE interior fbm eval
      filmMod = c;
      if(uQuality > 0.5){
        float caustic = pow(max(c,0.0), 2.2) * (0.20 + 0.55*z) * (1.0 - z);  // center stays clean
        glass += mix(SKY, MINT, c) * caustic * 0.06;
      }
    }

    /* ===== THIN-FILM INTERFERENCE (oil-on-water) — 0 extra field evals ===== */
    float drift  = 0.05*uTime*uReduce;
    float opd    = 2.4                        // base order count -> a few bands in body
                 + 7.0*(1.0 - ndv)*(1.0 - ndv)// rim packs bands tightly (grazing)
                 + 1.6*filmMod                // oil-slick swirl (reused noise)
                 + drift;                     // gentle animated shimmer
    vec3 film    = thinFilm(opd, uDispSpread + 0.18);

    /* soft fresnel-ish gate -> body desaturates to cream, rim blooms. NOT a hard ^9 graze. */
    float filmGate = pow(1.0 - ndv, 2.5);
    float vis      = clamp(filmGate * (0.85*uRimStr), 0.0, 0.85);

    glass = mix(glass, glass*film, vis);     // chromatic tint, not additive haze
    glass += filmGate*filmGate * (film-0.5) * 0.16 * uRimStr; // wet-meniscus crest at rim

    /* ===== specular glint (wet-glass) + soft sheen ===== */
    vec3 L = normalize(vec3(-0.35, 0.55, 0.78));
    vec3 H = normalize(L + V);
    float ndh = max(dot(nrm, H), 0.0);
    glass += pow(ndh, 240.0) * vec3(1.0,0.99,0.96) * 0.55;
    glass += pow(ndh, 22.0)  * vec3(0.92,0.95,1.0) * 0.06;

    float edge = smoothstep(R, R-0.010, d);
    col = mix(col, glass, edge);
    /* crisp iridescent contact line at the silhouette (thin-film colour, not white) */
    col += smoothstep(0.016, 0.0, abs(d-R)) * 0.22 * film;
  }

  /* ---------- scroll dim toward the editorial content ---------- */
  col = mix(col, mix(col, GREIGE, 0.35), uScroll*0.5);

  /* ---------- gentle page vignette (kept light/airy) ---------- */
  float vig = smoothstep(1.7, 0.4, length(uv));
  col = mix(col*0.965, col, vig);

  /* ---------- protect the left headline column (desktop) — softened ---------- */
  float leftMask = smoothstep(0.46, 0.05, px.x) * uLeftBias;
  col = mix(col, mix(col, CREAM, 0.5), leftMask*0.30);

  /* ---------- NaN scrub + display dither (kills 8-bit banding on cream) ---------- */
  col = (col==col) ? col : CREAM;
  col = clamp(col, 0.0, 1.0);
  float dN = ign(frag + 11.0*floor(mod(uTime*60.0,64.0))*uReduce) - 0.5;
  col += dN*(1.0/255.0);

  gl_FragColor = vec4(col, 1.0);
}
`;

  let prog, buf, loc;
  let uRes,uTime,uMouse,uScroll,uReduce,uQuality,uLeftBias,uGlassDisp,uDispSpread,uRimStr,uMobile;
  let scrollEased = 0, glReady = true;

  const isMobile = ()=> matchMedia('(max-width:860px)').matches && matchMedia('(orientation:portrait)').matches;

  function sh(type, src){
    const o = gl.createShader(type); gl.shaderSource(o, src); gl.compileShader(o);
    if(!gl.getShaderParameter(o, gl.COMPILE_STATUS)) console.warn(gl.getShaderInfoLog(o));
    return o;
  }

  function init(){
    glReady = true;
    prog = gl.createProgram();
    gl.attachShader(prog, sh(gl.VERTEX_SHADER, vsrc));
    gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, fsrc));
    gl.linkProgram(prog);
    if(!gl.getProgramParameter(prog, gl.LINK_STATUS)){
      glReady = false; console.warn('WebGL link failed:', gl.getProgramInfoLog(prog));
      document.documentElement.style.background='radial-gradient(120% 120% at 60% 0%, #fbfaf4, #efede7)';
      canvas.style.display='none'; return;
    }
    gl.useProgram(prog);
    buf = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 3,-1, -1,3]), gl.STATIC_DRAW);
    loc = gl.getAttribLocation(prog,'p'); gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    uRes       = gl.getUniformLocation(prog,'uRes');
    uTime      = gl.getUniformLocation(prog,'uTime');
    uMouse     = gl.getUniformLocation(prog,'uMouse');
    uScroll    = gl.getUniformLocation(prog,'uScroll');
    uReduce    = gl.getUniformLocation(prog,'uReduce');
    uQuality   = gl.getUniformLocation(prog,'uQuality');
    uLeftBias  = gl.getUniformLocation(prog,'uLeftBias');
    uGlassDisp = gl.getUniformLocation(prog,'uGlassDisp');
    uDispSpread= gl.getUniformLocation(prog,'uDispSpread');
    uRimStr    = gl.getUniformLocation(prog,'uRimStr');
    uMobile    = gl.getUniformLocation(prog,'uMobile');

    // static config
    gl.uniform1f(uReduce,    RM.matches ? 0.0 : 1.0);
    gl.uniform1f(uQuality,   1.0);
    gl.uniform1f(uLeftBias,  isMobile() ? 0.0 : 1.0);
    gl.uniform1f(uGlassDisp, 0.18);   // thin, editorial lens
    gl.uniform1f(uDispSpread,0.06);   // per-channel film wavelength split
    gl.uniform1f(uRimStr,    1.0);    // thin-film visibility
    gl.uniform1f(uMobile,    isMobile() ? 1.0 : 0.0);
  }
  init();

  // DPR clamp (<=1.5 default; <=1.25 coarse / <=480px) — JS PERF rule #2
  const coarse = matchMedia('(pointer:coarse)').matches;
  let DPR = Math.min(window.devicePixelRatio||1, coarse?1.25:1.5);
  if(matchMedia('(max-width:480px)').matches) DPR = Math.min(DPR,1.25);

  function resize(){
    const w=innerWidth, h=innerHeight;
    canvas.width=w*DPR; canvas.height=h*DPR;
    canvas.style.width=w+'px'; canvas.style.height=h+'px';
    gl.viewport(0,0,canvas.width,canvas.height);
    if(glReady){
      // recompute orientation-dependent uniforms (orientationchange / resize)
      gl.uniform1f(uMobile,   isMobile() ? 1.0 : 0.0);
      gl.uniform1f(uLeftBias, isMobile() ? 0.0 : 1.0);
    }
    if(RM.matches && glReady) draw(performance.now());
  }
  resize(); addEventListener('resize', resize);

  // pointer lerp
  let mx=0.5,my=0.5,tx=0.5,ty=0.5;
  addEventListener('mousemove', e=>{ tx=e.clientX/innerWidth; ty=1-e.clientY/innerHeight; });
  addEventListener('touchmove', e=>{ if(e.touches[0]){ tx=e.touches[0].clientX/innerWidth; ty=1-e.touches[0].clientY/innerHeight; } }, {passive:true});

  const t0=performance.now();
  let raf=0, running=false, lastT=performance.now();
  let samples=0, acc=0, degraded=false, qStepped=false;

  function draw(now){
    mx+=(tx-mx)*0.05; my+=(ty-my)*0.05;
    gl.uniform2f(uRes, canvas.width, canvas.height);
    gl.uniform1f(uTime, RM.matches ? 6.0 : (now-t0)/1000);
    gl.uniform2f(uMouse, mx, my);
    gl.uniform1f(uScroll, scrollEased);
    gl.drawArrays(gl.TRIANGLES, 0, 3);
  }

  // adaptive: avg frame > 28ms over 60 frames -> first lite quality, then lower DPR, then stop probing
  function frame(now){
    if(!running || gl.isContextLost()) return;
    const dt=now-lastT; lastT=now;
    // advance the eased scroll signal inside the one rAF that consumes it
    const h=innerHeight;
    const tgt=Math.min((window.scrollY||0)/Math.max(h,1), 1);
    scrollEased += (tgt-scrollEased)*0.08;
    draw(now);
    if(!degraded){
      acc+=dt;
      if(++samples>=60){
        const avg=acc/60;
        if(avg>28){
          if(!qStepped){ qStepped=true; gl.uniform1f(uQuality,0.0); }
          else if(DPR>1){ DPR=Math.max(1,DPR-0.5); resize(); degraded=true; }
        } else { degraded=true; }
        samples=0; acc=0;
      }
    }
    raf=requestAnimationFrame(frame);
  }
  function start(){ if(running||!glReady) return; running=true; lastT=performance.now(); cancelAnimationFrame(raf); raf=requestAnimationFrame(frame); }
  function stop(){ running=false; cancelAnimationFrame(raf); }

  /* ---- PERF rule #1: run loop only when hero visible AND page visible ---- */
  let heroVisible = true, pageVisible = !document.hidden;
  function sync(){ if(RM.matches) return; (heroVisible && pageVisible) ? start() : stop(); }

  if(glReady){
    if(RM.matches){ draw(performance.now()); /* single static frame */ }
    else { start(); }
  }
  if('IntersectionObserver' in window){
    const hero = document.getElementById('top');
    const hio = new IntersectionObserver(es=>{ heroVisible = es[0].isIntersecting; sync(); }, {rootMargin:'0px', threshold:0});
    if(hero) hio.observe(hero);
  }
  document.addEventListener('visibilitychange', ()=>{ if(RM.matches) return; pageVisible=!document.hidden; sync(); });

  /* context loss / restore */
  canvas.addEventListener('webglcontextlost', e=>{ e.preventDefault(); stop(); }, false);
  canvas.addEventListener('webglcontextrestored', ()=>{ init(); if(!glReady) return; resize(); RM.matches ? draw(performance.now()) : sync(); }, false);
})();

/* ============ custom cursor ============ */
(function(){
  if(matchMedia('(pointer:coarse)').matches) return;
  if(RM.matches){ return; }
  const ring=document.querySelector('.cur'), dot=document.querySelector('.cur-d');
  if(!ring||!dot) return;
  document.documentElement.classList.add('cur-on'); // enable cursor:none only now that we've bound
  let rx=0,ry=0,dx=0,dy=0,curRaf=0;
  addEventListener('mousemove',e=>{ dx=e.clientX; dy=e.clientY; });
  addEventListener('mousedown',()=>ring.classList.add('press'));
  addEventListener('mouseup',()=>ring.classList.remove('press'));
  function loop(){ if(!document.hidden){
      rx+=(dx-rx)*0.18; ry+=(dy-ry)*0.18;
      ring.style.transform=`translate(${rx-17}px,${ry-17}px)`;
      dot.style.transform=`translate(${dx-2.5}px,${dy-2.5}px)`;
    } curRaf=requestAnimationFrame(loop); }
  loop();
  document.addEventListener('visibilitychange',()=>{ if(!document.hidden){ cancelAnimationFrame(curRaf); loop(); } });
  document.querySelectorAll('a,.mag,.burger,.card').forEach(el=>{
    el.addEventListener('mouseenter',()=>ring.classList.add('grow'));
    el.addEventListener('mouseleave',()=>ring.classList.remove('grow'));
  });
  document.querySelectorAll('h1,h2,.sec-title,p').forEach(el=>{
    el.addEventListener('mouseenter',()=>ring.classList.add('text'));
    el.addEventListener('mouseleave',()=>ring.classList.remove('text'));
  });
})();

/* ============ magnetic buttons (compose with hover-lift via CSS vars) ============ */
(function(){
  if(matchMedia('(max-width:860px)').matches || RM.matches) return;
  document.querySelectorAll('.mag').forEach(el=>{
    let tx=0,ty=0,cx=0,cy=0,raf=null,active=false,rect=null;
    const run=()=>{ cx+=(tx-cx)*0.15; cy+=(ty-cy)*0.15;
      el.style.setProperty('--mtx',cx.toFixed(2)+'px'); el.style.setProperty('--mty',cy.toFixed(2)+'px');
      if(Math.abs(tx-cx)>0.1||Math.abs(ty-cy)>0.1||active){ raf=requestAnimationFrame(run); } else { raf=null; } };
    el.addEventListener('mouseenter',()=>{ rect=el.getBoundingClientRect(); }); // cache rect, avoid pointer-rate layout reads
    el.addEventListener('mousemove',e=>{ const r=rect||(rect=el.getBoundingClientRect());
      tx=(e.clientX-r.left-r.width/2)*0.18; ty=(e.clientY-r.top-r.height/2)*0.22; active=true; if(!raf) raf=requestAnimationFrame(run); });
    el.addEventListener('mouseleave',()=>{ tx=0; ty=0; active=false; rect=null; if(!raf) raf=requestAnimationFrame(run); });
  });
  // card spotlight follow — cache rect on enter, coalesce writes via rAF (offsetX/Y, no per-move getBoundingClientRect)
  document.querySelectorAll('.card').forEach(c=>{
    let sx=0,sy=0,sraf=null;
    const apply=()=>{ c.style.setProperty('--mx',sx+'px'); c.style.setProperty('--my',sy+'px'); sraf=null; };
    c.addEventListener('mousemove',e=>{ sx=e.offsetX; sy=e.offsetY; if(!sraf) sraf=requestAnimationFrame(apply); });
  });
})();

/* ============ reveal (robust) + nav + scroll progress + hero parallax + scroll-spy ============ */
(function(){
  function showAll(){ document.querySelectorAll('.reveal:not(.in)').forEach(e=>e.classList.add('in')); }

  if(RM.matches || !('IntersectionObserver' in window)){
    showAll();
  } else {
    const io=new IntersectionObserver(es=>{ es.forEach(x=>{ if(!x.isIntersecting) return;
      // hero is owned by the curtain/hero IIFE — never JS-stagger it here
      if(x.target.closest('.hero')){ io.unobserve(x.target); return; }
      const grp=x.target.closest('.work-grid,.cap-grid,.about-grid,.sec-head,.wrap')||document.body;
      const sibs=[...grp.querySelectorAll('.reveal')].filter(n=>n.dataset.io!=='done');
      const i=sibs.indexOf(x.target);
      x.target.style.transitionDelay=Math.min(i,6)*0.07+'s';
      x.target.classList.add('in'); x.target.dataset.io='done'; io.unobserve(x.target);
    });},{threshold:.12, rootMargin:'0px 0px -40px 0px'});
    document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
    // hero is above the fold -> reveal next frame no matter what
    requestAnimationFrame(()=>document.querySelectorAll('.hero .reveal').forEach(e=>e.classList.add('in')));
    // hard watchdog: if anything is still hidden, force it visible
    setTimeout(showAll, 2500);
    document.addEventListener('visibilitychange',function once(){ if(!document.hidden){ showAll(); document.removeEventListener('visibilitychange',once);} });
    addEventListener('pageshow',showAll);
  }

  const nav=document.getElementById('nav');
  const bar=document.getElementById('sprog');
  const heroWrap=document.querySelector('.hero .wrap');
  const heroEl=document.querySelector('header.hero');
  const heroH1=document.querySelector('.hero h1');
  const heroSub=document.querySelector('.hero .sub');
  const reduce=RM.matches;
  if(heroWrap && !reduce) heroWrap.style.willChange='transform,opacity';

  let cur=0,target=0,sraf=null;
  function onTick(y){
    // nav scrolled state (merged from the old separate scroll listener)
    nav.classList.toggle('scrolled', y>40);
    const h=document.documentElement.scrollHeight-innerHeight;
    if(bar) bar.style.transform='scaleX('+(h?Math.max(0,Math.min(1,y/h)):0)+')';
    if(reduce) return; // no scroll-linked motion under prefers-reduced-motion
    const t=Math.min(y/innerHeight,1);
    const e=t*t*(3-2*t);
    if(heroEl) heroEl.style.setProperty('--hero-scroll', e.toFixed(3));
    if(heroWrap){
      if(t>=1){ // hero scrolled past — stop per-frame string writes on the big text subtree
        heroWrap.style.transform='translate3d(0,'+(innerHeight*0.16)+'px,0)';
        heroWrap.style.opacity='0.08';
      } else {
        heroWrap.style.transform='translate3d(0,'+(y*0.16)+'px,0)';
        heroWrap.style.opacity=(1-e*0.92).toFixed(3);
        if(heroH1) heroH1.style.transform='translate3d(0,'+(y*0.05)+'px,0)';
        if(heroSub) heroSub.style.transform='translate3d(0,'+(y*-0.04)+'px,0)';
      }
    }
  }
  function tick(){ cur+=(target-cur)*0.12; onTick(cur);
    if(Math.abs(target-cur)>0.4){ sraf=requestAnimationFrame(tick); } else { cur=target; onTick(cur); sraf=null; } }
  addEventListener('scroll',()=>{ target=window.scrollY||window.pageYOffset; if(reduce){ onTick(target); return; } if(!sraf) sraf=requestAnimationFrame(tick); },{passive:true});
  onTick(0);

  // nav scroll-spy: one IO over the 4 sections -> .active + aria-current
  if('IntersectionObserver' in window){
    const map={};
    document.querySelectorAll('.nav-links a[href^="#"]').forEach(a=>{ map[a.getAttribute('href').slice(1)]=a; });
    const spy=new IntersectionObserver(es=>{ es.forEach(x=>{ const a=map[x.target.id]; if(!a) return;
      if(x.isIntersecting){
        Object.values(map).forEach(l=>{ l.classList.remove('active'); l.removeAttribute('aria-current'); });
        a.classList.add('active'); a.setAttribute('aria-current','true');
      }
    }); },{rootMargin:'-45% 0px -45% 0px', threshold:0});
    ['about','work','capabilities','contact'].forEach(id=>{ const s=document.getElementById(id); if(s) spy.observe(s); });
  }

  // mobile menu (accessible focus trap + inert background)
  const burger=document.getElementById('burger'), links=document.getElementById('navlinks');
  const sibs=[document.querySelector('header.hero'), document.getElementById('main'), document.querySelector('footer'), document.getElementById('sprog')].filter(Boolean);
  function setInert(on){ sibs.forEach(el=>{ if(on){ el.setAttribute('inert',''); el.setAttribute('aria-hidden','true'); } else { el.removeAttribute('inert'); el.removeAttribute('aria-hidden'); } }); }
  function trapTab(e){
    if(e.key!=='Tab' || !links.classList.contains('open')) return;
    const f=[burger, ...links.querySelectorAll('a')];
    const first=f[0], last=f[f.length-1];
    if(e.shiftKey && document.activeElement===first){ e.preventDefault(); last.focus(); }
    else if(!e.shiftKey && document.activeElement===last){ e.preventDefault(); first.focus(); }
  }
  const openMenu=()=>{ burger.classList.add('x'); links.classList.add('open'); document.body.classList.add('menu-open');
    burger.setAttribute('aria-expanded','true'); burger.setAttribute('aria-label','Close menu');
    setInert(true); addEventListener('keydown',trapTab);
    const a=links.querySelector('a'); if(a) a.focus(); };
  const closeMenu=()=>{ burger.classList.remove('x'); links.classList.remove('open'); document.body.classList.remove('menu-open');
    burger.setAttribute('aria-expanded','false'); burger.setAttribute('aria-label','Open menu');
    setInert(false); removeEventListener('keydown',trapTab); };
  burger.addEventListener('click',()=> burger.getAttribute('aria-expanded')==='true'?closeMenu():openMenu());
  links.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{ closeMenu(); burger.focus(); }));
  addEventListener('keydown',e=>{ if(e.key==='Escape' && links.classList.contains('open')){ closeMenu(); burger.focus(); } });
})();

/* ============ intro curtain (masks font swap, stages first cascade) ============ */
(function(){
  const intro=document.getElementById('intro');
  if(!intro) return;
  if(RM.matches){ intro.remove(); return; }
  const lift=()=>{ intro.classList.add('up');
    document.querySelectorAll('.hero .reveal').forEach((el,i)=>{ el.style.transitionDelay=(0.15+i*0.08)+'s'; el.classList.add('in'); });
    setTimeout(()=>intro.remove(),1150); };
  const ready = document.fonts ? document.fonts.ready : Promise.resolve();
  let done=false; const go=()=>{ if(done) return; done=true; setTimeout(lift,500); };
  ready.then(go); setTimeout(go,1800); /* hard cap so it never hangs behind GFW */
})();

/* ============ HUD: live clock (GMT+8) + rAF-throttled cursor coords ============ */
(function(){
  var clk=document.getElementById('hudclock');
  if(clk){
    var fmt=null;
    try{ fmt=new Intl.DateTimeFormat('en-GB',{hour:'2-digit',minute:'2-digit',hour12:false,timeZone:'Asia/Shanghai'}); }catch(e){}
    var tickClock=function(){
      var s;
      if(fmt){ s=fmt.format(new Date()); }
      else{ var d=new Date(Date.now()+(480+new Date().getTimezoneOffset())*60000);
            s=('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2); }
      clk.textContent=s;
    };
    tickClock(); setInterval(tickClock,30000);
  }
  var xy=document.getElementById('hudxy');
  if(xy && !matchMedia('(pointer:coarse)').matches){
    var hx=0,hy=0,hraf=null;
    var pad=function(n){ n=Math.max(0,Math.round(n)); return (n<10?'000':n<100?'00':n<1000?'0':'')+n; };
    var paint=function(){ xy.textContent=pad(hx)+' X '+pad(hy)+' Y'; hraf=null; };
    addEventListener('pointermove',function(e){ hx=e.clientX; hy=e.clientY; if(!hraf) hraf=requestAnimationFrame(paint); },{passive:true});
  }
})();
</script>

<style>body.menu-open{ overflow:hidden; }</style>
</body>
</html>
