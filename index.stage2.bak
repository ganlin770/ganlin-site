<style>
  *{ margin:0; padding:0; box-sizing:border-box; }
  :root{
    /* ---- haoqi warm-cream editorial palette ---- */
    --bg:#fbfaf4;            /* primary warm cream */
    --bg-2:#efede7;          /* greige — alt sections / inset grids / cards */
    --ink:#191b1b;           /* primary near-black text (16.5:1 on cream) */
    --dim:#51544f;           /* muted warm gray body-secondary (7.35:1 on cream — AA/AAA) */
    --faint:#5f625c;         /* darkened prose-meta gray (5.30:1 cream / 4.74:1 greige — AA prose) */
    --label:#767972;         /* lighter token — ONLY for tracked uppercase micro-labels (decorative) */
    --line:rgba(25,27,27,.12);   /* dark-on-light hairline */
    --line-2:rgba(25,27,27,.07); /* fainter hairline / inset-grid gaps */
    --glass:rgba(255,255,255,.55);  /* light glass card fill over cream */
    --glass-2:rgba(255,255,255,.72);/* light glass hover (more opaque) */
    --card-sh:0 18px 50px -22px rgba(25,27,27,.28), 0 2px 8px rgba(25,27,27,.05); /* soft dark shadow */
    /* iridescent accent spectrum (soft pastels for art/rims) */
    --mint:#80daac; --sky:#8dcbff; --peri:#afb6ff; --coral:#ffa3a3; --gold:#ebc669;
    /* deep punctuation accents (AA-passing on cream) */
    --indigo:#5e53e3;  /* 5.25:1 */
    --blue:#0077bc;    /* 4.60:1 */
    --green:#00784a;   /* 5.31:1 */
    --red:#c0434c;     /* 4.84:1 */
    /* legacy g1/g2/g3 kept as aliases so existing rules resolve; remapped deep */
    --g1:var(--indigo); --g2:var(--blue); --g3:var(--indigo);
    --on-ink:#fbfaf4;  /* text/icon color when sitting on a solid ink fill */
    /* type-scale + measure tokens */
    --ease-out:cubic-bezier(.16,1,.3,1);    /* ---- type system (haoqi mirror): Archivo display / Space Mono HUD / Inter body ---- */
    --font-display:"Archivo",-apple-system,"Helvetica Neue",Arial,sans-serif;
    --font-mono:"Space Mono",ui-monospace,"SF Mono",Menlo,Consolas,monospace;
    --font-body:"Inter",-apple-system,"Helvetica Neue",Arial,sans-serif;
    --lime:#c0fe04;          /* signature accent — ink text ON lime only */
    --measure:66ch;
  }
  html{ scroll-behavior:smooth; -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility; background:var(--bg); }
  body{
    background:var(--bg); color:var(--ink);
    font-family:var(--font-body);
    line-height:1.55; overflow-x:hidden;
  }
  /* cursor:none only enabled once the custom cursor IIFE has bound (fallback if JS fails) */
  html.cur-on body{ cursor:none; }
  @media (max-width:860px){ html.cur-on body{ cursor:auto; } }
  a{ color:inherit; text-decoration:none; }
  ::selection{ background:rgba(94,83,227,.22); color:var(--ink); }

  /* ---------- focus-visible (keyboard) ---------- */
  a:focus-visible, .btn:focus-visible, .nav-cta:focus-visible, .card:focus-visible,
  .clink:focus-visible, .burger:focus-visible, .skip:focus-visible, #main:focus-visible{
    outline:2px solid var(--indigo); outline-offset:3px; border-radius:6px;
  }
  #main:focus-visible{ outline:none; }
  .card:focus-visible{ outline-offset:4px; }

  /* ---------- skip link ---------- */
  .skip{ position:fixed; top:10px; left:10px; z-index:200; transform:translateY(-160%);
    background:var(--ink); color:var(--on-ink); padding:10px 16px; border-radius:99px; font-size:14px;
    font-weight:500; transition:transform .25s var(--ease-out); }
  .skip:focus{ transform:none; }
  .vh{ position:absolute!important; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden;
    clip:rect(0 0 0 0); white-space:nowrap; border:0; }

  /* ---------- WebGL canvas ---------- */
  #gl{ position:fixed; inset:0; width:100%; height:100%; z-index:-2; display:block; }
  .noise-fix{ position:fixed; inset:0; z-index:-1; pointer-events:none;
    background:radial-gradient(120% 80% at 50% 0%, transparent 45%, rgba(25,27,27,.06) 100%); }

  /* ---------- scroll progress ---------- */
  #sprog{ position:fixed; top:0; left:0; height:2px; width:100%; z-index:101;
    transform:scaleX(0); transform-origin:0 50%; will-change:transform;
    background:linear-gradient(90deg,var(--indigo),var(--blue)); box-shadow:0 0 10px rgba(94,83,227,.35); }

  /* ---------- custom cursor (light-bg blend flip) ---------- */
  .cur, .cur-d{ position:fixed; top:0; left:0; border-radius:50%; pointer-events:none; z-index:9999;
    transform:translate(-50%,-50%); }
  .cur{ width:34px; height:34px; border:1px solid rgba(25,27,27,.55); mix-blend-mode:multiply; background:transparent;
    transition:width .25s var(--ease-out), height .25s var(--ease-out), background .25s, border-color .25s; }
  .cur-d{ width:5px; height:5px; background:var(--ink); box-shadow:0 0 0 1px rgba(255,255,255,.55); mix-blend-mode:normal; }
  .cur.grow{ width:64px; height:64px; background:rgba(25,27,27,.06); border-color:transparent; }
  .cur.text{ width:3px; height:30px; border-radius:2px; border-color:transparent; background:rgba(25,27,27,.42); }
  .cur.press{ width:24px; height:24px; background:rgba(25,27,27,.10); border-color:transparent; }
  @media (max-width:860px){ .cur,.cur-d{ display:none; } }

  /* ---------- intro curtain ---------- */
  #intro{ position:fixed; inset:0; z-index:9998; background:var(--bg); color:var(--ink); display:flex;
    flex-direction:column; align-items:center; justify-content:center; gap:.18em;
    font-family:var(--font-display); font-weight:900; text-transform:uppercase;
    font-size:clamp(34px,7vw,72px); letter-spacing:-.02em; line-height:.92; transition:transform 1.05s cubic-bezier(.76,0,.24,1); }
  #intro.up{ transform:translateY(-101%); }
  #intro .iwords{ display:flex; gap:.4em; align-items:baseline; overflow:hidden; }
  #intro .il{ display:inline-block; transform:translateY(108%);
    animation:ilwipe .9s cubic-bezier(.16,1,.3,1) forwards; }
  #intro .il:nth-child(2){ animation-delay:.14s; color:var(--dim); }
  #intro .irule{ height:1px; width:clamp(80px,18vw,200px); margin-top:.34em;
    background:linear-gradient(90deg,var(--lime),var(--ink) 55%,transparent);
    transform:scaleX(0); transform-origin:0 50%; animation:irule .9s .5s cubic-bezier(.16,1,.3,1) forwards; }
  @keyframes ilwipe{ to{ transform:none; } }
  @keyframes irule{ to{ transform:scaleX(1); } }

  /* ---------- layout ---------- */
  .wrap{ width:min(1180px, 90vw); margin:0 auto; }

  /* ---------- nav ---------- */
  nav{ position:fixed; top:0; left:0; right:0; z-index:100;
    display:flex; align-items:center; justify-content:space-between;
    padding:18px max(28px,5vw); transition:padding .4s ease, background .4s ease, border-color .4s ease;
    border-bottom:1px solid transparent;
    font-family:var(--font-mono); text-transform:uppercase;
    padding-left:max(28px,5vw,env(safe-area-inset-left)); padding-right:max(28px,5vw,env(safe-area-inset-right)); }
  nav.scrolled{ padding:12px max(28px,5vw); background:rgba(251,250,244,.92);
    border-bottom:1px solid var(--line); }
  .brand{ font-family:var(--font-mono); font-weight:700; letter-spacing:.08em; font-size:12px;
    display:flex; gap:12px; align-items:center; color:var(--ink); white-space:nowrap; }
  .brand b{ font-weight:700; }
  .brand .role-tag{ font-weight:400; color:var(--dim); letter-spacing:.06em; }
  .brand .dot{ width:8px; height:8px; border-radius:0; background:var(--lime); border:1px solid rgba(25,27,27,.28); flex:none; }
  .nav-links{ display:flex; gap:30px; align-items:center; font-size:11.5px; letter-spacing:.14em; color:var(--dim); }
  .nav-links a{ position:relative; transition:color .3s; }
  .nav-links a::after{ content:""; position:absolute; left:0; bottom:-4px; width:100%; height:2px; background:var(--lime);
    transform:scaleX(0); transform-origin:0 50%; transition:transform .4s var(--ease-out); }
  .nav-links a:hover{ color:var(--ink); }
  .nav-links a:not(:hover)::after{ transform-origin:100% 50%; }
  .nav-links a:hover::after, .nav-links a:focus-visible::after{ transform:scaleX(1); }
  .nav-links a.active{ color:var(--ink); }
  .nav-links a.active::after{ transform:scaleX(1); transform-origin:0 50%; }
  .nav-cta{ color:var(--ink); font-weight:700; padding:3px 7px; margin:-3px -7px; transition:background .3s, color .3s; }
  .nav-cta::after{ display:none; }
  .nav-cta .brk{ font-weight:400; color:var(--dim); transition:color .3s; }
  .nav-cta:hover{ background:var(--lime); color:var(--ink); }
  .nav-cta:hover .brk{ color:var(--ink); }
  .burger{ display:none; }
  @media (max-width:860px){
    .brand .role-tag{ display:none; }
    .nav-links{ display:none; }
    .nav-links.open{ display:flex; position:fixed; inset:0; z-index:100; flex-direction:column; justify-content:center; align-items:center;
      gap:32px; font-size:18px; letter-spacing:.22em; background:#fbfaf4; }
    .burger{ display:block; z-index:101; width:30px; height:18px; position:relative; cursor:pointer;
      padding:13px; margin:-13px; box-sizing:content-box; background:none; border:0; }
    .burger span{ position:absolute; left:13px; width:30px; height:1.5px; background:var(--ink); transition:.35s; }
    .burger span:nth-child(1){ top:13px; } .burger span:nth-child(2){ top:21px; } .burger span:nth-child(3){ top:29px; }
    .burger.x span:nth-child(1){ top:21px; transform:rotate(45deg); }
    .burger.x span:nth-child(2){ opacity:0; }
    .burger.x span:nth-child(3){ top:21px; transform:rotate(-45deg); }
  }

  /* ---------- HUD frame: bottom rail + column hairlines + registration marks (GPU-free) ---------- */
  .hud-rail{ position:fixed; left:0; right:0; bottom:0; z-index:99; pointer-events:none;
    display:flex; align-items:flex-end; justify-content:space-between;
    padding-left:max(28px,5vw,env(safe-area-inset-left));
    padding-right:max(28px,5vw,env(safe-area-inset-right));
    padding-bottom:max(14px, calc(env(safe-area-inset-bottom) + 6px));
    font-family:var(--font-mono); font-size:10.5px; letter-spacing:.14em;
    text-transform:uppercase; color:var(--dim); font-variant-numeric:tabular-nums; }
  .hud-cell{ display:inline-flex; align-items:center; gap:7px; white-space:nowrap; }
  .hud-xy{ position:absolute; left:50%; transform:translateX(-50%); }
  .hud-globe svg{ display:block; opacity:.7; }
  @media (pointer:coarse){ .hud-xy{ display:none; } }
  @media (max-width:640px){ .hud-xy{ display:none; } }
  .hud-frame{ position:fixed; inset:0; z-index:98; pointer-events:none;
    --hud-col-l:max(5vw, calc(50% - 590px));
    --hud-col-r:min(95vw, calc(50% + 590px)); }
  .hud-col{ position:absolute; top:0; bottom:0; width:1px; background:rgba(25,27,27,.08); display:block; }
  .hud-col-l{ left:var(--hud-col-l); }
  .hud-col-r{ left:var(--hud-col-r); }
  .hud-x{ position:absolute; width:11px; height:11px; margin:-6px 0 0 -6px; display:block; }
  .hud-x::before, .hud-x::after{ content:""; position:absolute; background:rgba(25,27,27,.32); }
  .hud-x::before{ left:0; right:0; top:5px; height:1px; }
  .hud-x::after{ top:0; bottom:0; left:5px; width:1px; }
  @media (max-width:860px){ .hud-frame{ display:none; } }

  /* ---------- hero (reference anatomy: mono microcopy top zone, giant Archivo-900 statement at the base) ---------- */
  header.hero{ min-height:100vh; min-height:100svh; display:flex; flex-direction:column; justify-content:flex-end;
    padding:120px max(28px,5vw) clamp(84px,11vh,140px); position:relative; }
  /* localized contrast floor — cream fade keeps the ink statement readable over the light field */
  header.hero::before{ content:""; position:absolute; inset:0; z-index:-1; pointer-events:none;
    background:linear-gradient(100deg, rgba(251,250,244,.64) 0%, rgba(251,250,244,.34) 52%, transparent 80%); }
  /* scroll-linked cream wash toward the page as the hero rises */
  header.hero::after{ content:""; position:absolute; inset:0; z-index:-1; pointer-events:none;
    background:linear-gradient(180deg, transparent 60%, var(--bg) 100%);
    opacity:var(--hero-scroll,0); transition:opacity .2s linear; }
  .hero .wrap{ position:relative; width:100%; max-width:none; margin-left:0; }
  /* mono microcopy top zone (sits under the fixed HUD) */
  .hero-top{ position:absolute; top:clamp(92px,13vh,150px); left:max(28px,5vw); right:max(28px,5vw); z-index:1;
    display:flex; justify-content:space-between; align-items:flex-start; gap:36px;
    font-family:"Space Mono",ui-monospace,monospace; opacity:calc(1 - var(--hero-scroll,0)*1.2); }
  .hero .tagline{ font-size:12px; font-weight:700; letter-spacing:.14em; line-height:1.8; color:var(--ink); text-transform:uppercase; }
  .hero .sub{ max-width:40ch; color:var(--dim); font-size:11.5px; line-height:1.75; letter-spacing:.02em; text-align:left; }
  .id-line{ font-family:"Space Mono",ui-monospace,monospace; font-size:11.5px; font-weight:700; letter-spacing:.22em;
    text-transform:uppercase; color:var(--dim); display:flex; align-items:center; gap:12px; }
  .id-line::before{ content:""; width:10px; height:10px; background:#c0fe04; border:1px solid rgba(25,27,27,.55); flex:none; }
  .hero h1{ font-family:"Archivo",Inter,"Helvetica Neue",sans-serif; font-weight:900; text-transform:uppercase; color:var(--ink);
    line-height:.9; font-size:clamp(48px,6.6vw,132px); letter-spacing:-.018em; margin:20px 0 0; margin-left:-.045em; }
  .hero h1 .hl-ln{ display:block; }
  .hero .cta-row{ display:flex; gap:14px; margin-top:clamp(30px,4.5vh,46px); flex-wrap:wrap; }
  .btn{ display:inline-flex; align-items:center; gap:12px; padding:15px 24px; border-radius:8px;
    font-family:"Space Mono",ui-monospace,monospace; font-weight:700; font-size:12.5px; letter-spacing:.14em; text-transform:uppercase;
    transition:background .35s var(--ease-out), border-color .35s, box-shadow .35s, color .35s;
    transform:translate(var(--mtx,0px), calc(var(--mty,0px) + var(--lift,0px))); }
  .btn.solid{ background:var(--ink); color:var(--on-ink); }
  .btn.solid .arr{ color:#c0fe04; }
  .btn.solid:hover{ --lift:-2px; will-change:transform; box-shadow:0 14px 38px -16px rgba(25,27,27,.45), 0 0 0 1px rgba(192,254,4,.5); }
  .btn.ghost{ border:1px solid rgba(25,27,27,.42); color:var(--ink); background:rgba(251,250,244,.55); }
  .btn.ghost:hover{ --lift:-2px; will-change:transform; border-color:var(--ink); background:var(--glass-2); }
  .btn .arr{ transition:transform .35s; }
  .btn:hover .arr{ transform:translate(4px,-4px); }
  .scroll-hint{ position:absolute; bottom:max(34px, calc(env(safe-area-inset-bottom) + 18px)); left:max(28px,5vw); transform:none;
    font-family:"Space Mono",ui-monospace,monospace; font-size:10px; letter-spacing:.3em; text-transform:uppercase; color:var(--label);
    display:flex; flex-direction:column; align-items:center; gap:10px; }
  .scroll-hint .line{ width:1px; height:48px; background:linear-gradient(var(--dim),transparent); position:relative; overflow:hidden; }
  .scroll-hint .line::after{ content:""; position:absolute; top:-50%; left:0; width:100%; height:50%; background:var(--ink);
    animation:drop 2.2s cubic-bezier(.6,0,.2,1) infinite; }
  @keyframes drop{ 0%{ top:-50%; } 100%{ top:120%; } }

  /* ---------- hero sticker chips (die-cut, decorative) ---------- */
  .stk{ position:absolute; z-index:2; pointer-events:none; -webkit-user-select:none; user-select:none;
    font-family:"Space Mono",ui-monospace,monospace; font-weight:700; font-size:11.5px; letter-spacing:.08em;
    text-transform:uppercase; white-space:nowrap; padding:9px 14px; border-radius:9px;
    box-shadow:0 0 0 3px rgba(255,255,255,.92), 0 12px 26px -12px rgba(25,27,27,.4);
    transform:rotate(var(--r,0deg)); animation:stk-float var(--fdur,7s) ease-in-out var(--fdel,0s) infinite; }
  .stk-lime{ background:#c0fe04; color:var(--ink); --r:-7deg; --fdur:7.5s; top:60vh; right:9%; }
  .stk-ink{ background:var(--ink); color:var(--on-ink); --r:4deg; --fdur:9s; --fdel:-3s; top:50vh; right:4%; }
  .stk-arrow{ padding:0; background:none; box-shadow:none; --r:10deg; --fdur:6s; --fdel:-1.5s; top:72vh; right:26%; }
  .stk-arrow svg{ display:block; width:40px; height:40px; }
  @keyframes stk-float{ 0%,100%{ transform:rotate(var(--r,0deg)) translate3d(0,0,0); } 50%{ transform:rotate(var(--r,0deg)) translate3d(0,-9px,0); } }
  @media (max-width:1100px),(max-height:620px){ .stk{ display:none; } }
  .btn.solid:hover .arr{ transform:translate(4px,4px); } /* the ↘ dives into the page */
  @media (max-width:860px){
    .hero-top{ flex-direction:column; gap:16px; }
  }

  /* ---------- intro statement (huge light-gray sentence, ink underlined repo links) ---------- */
  .panel.statement{ padding:clamp(110px,15vw,200px) 0 clamp(16px,2.5vw,36px); }
  .stmt{ font-family:"Archivo",Inter,"Helvetica Neue",sans-serif; font-weight:600; font-size:clamp(28px,4.5vw,62px);
    line-height:1.16; letter-spacing:-.02em; color:var(--label); }
  .stmt-link{ color:var(--ink); text-decoration:underline; text-decoration-thickness:.05em; text-underline-offset:.09em;
    text-decoration-color:rgba(25,27,27,.5); transition:background .25s, text-decoration-color .25s; }
  .stmt-link:hover, .stmt-link:focus-visible{ background:#c0fe04; text-decoration-color:var(--ink); }

  /* ---------- content scrim (near-opaque cream, NO heavy backdrop blur) ---------- */
  .content{ position:relative; z-index:1;
    background:linear-gradient(180deg, rgba(251,250,244,0) 0%, rgba(251,250,244,.80) 8%, rgba(251,250,244,.95) 22%, #fbfaf4 100%);
    backdrop-filter:none; -webkit-backdrop-filter:none;
    border-top:1px solid var(--line-2); box-shadow:inset 0 1px 0 rgba(255,255,255,.6); }
  section.panel{ padding:clamp(80px,11vw,150px) 0; }
  #about{ padding-top:clamp(120px,16vw,220px); }
  .sec-head{ display:flex; flex-direction:column; align-items:flex-start; gap:14px;
    margin-bottom:clamp(56px,7vw,88px); padding-bottom:24px;
    border-bottom:1px solid var(--line-2);
    border-image:linear-gradient(90deg,rgba(94,83,227,.30),rgba(141,203,255,.22),transparent 70%) 1; }
  .sec-num{ font-family:"Space Grotesk",sans-serif; font-size:12px; color:var(--label);
    letter-spacing:.32em; text-transform:uppercase; }
  .sec-title{ font-family:"Fraunces",serif; font-optical-sizing:auto; font-weight:400; font-size:clamp(34px,5.2vw,60px); line-height:1.02; letter-spacing:-.03em; color:var(--ink); }

  /* ---------- about ---------- */
  .about-grid{ display:grid; grid-template-columns:1.55fr .9fr; gap:clamp(48px,7vw,96px); align-items:start; }
  .about-lead{ font-family:"Fraunces",serif; font-optical-sizing:auto; font-weight:300; font-size:clamp(22px,2.8vw,32px); line-height:1.4; letter-spacing:-.015em; color:var(--ink); max-width:24ch; }
  .about-lead .hl{ color:var(--indigo); -webkit-text-fill-color:var(--indigo); font-style:italic; }
  .about-body{ color:var(--dim); font-size:16px; line-height:1.78; letter-spacing:.005em; max-width:62ch; }
  .about-body p{ margin-bottom:16px; }
  .about-body p:last-child{ margin-bottom:0; }
  .stats{ display:grid; grid-template-columns:1fr 1fr; gap:1px; margin-top:14px; background:var(--line-2);
    border:1px solid var(--line-2); border-radius:16px; overflow:hidden; }
  .stat{ background:rgba(255,255,255,.5); padding:26px 22px; }
  .stat .n{ font-family:"Fraunces",serif; font-optical-sizing:auto; font-size:34px; font-weight:400; color:var(--ink); }
  .stat .l{ font-size:12.5px; color:var(--faint); margin-top:4px; letter-spacing:.02em; }

  /* ---------- work ---------- */
  .work-grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:24px; }
  .card{ position:relative; border:1px solid var(--line); border-radius:20px; padding:30px 30px 26px;
    background:var(--glass); box-shadow:var(--card-sh); overflow:hidden; transition:transform .5s var(--ease-out), border-color .5s, background .5s, box-shadow .5s;
    display:flex; flex-direction:column; min-height:200px; }
  .card::before{ content:""; position:absolute; inset:0; border-radius:20px; padding:1px; opacity:0; transition:opacity .5s;
    background:linear-gradient(130deg,var(--peri),var(--sky),transparent 60%);
    -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0); -webkit-mask-composite:xor; mask-composite:exclude; }
  .card::after{ content:""; position:absolute; width:340px; height:340px; border-radius:50%; top:var(--my,50%); left:var(--mx,50%);
    transform:translate(-50%,-50%); background:radial-gradient(circle,rgba(94,83,227,.07),transparent 60%); opacity:0; transition:opacity .4s; pointer-events:none; }
  .card:hover{ transform:translateY(-6px); border-color:transparent; background:var(--glass-2); box-shadow:0 26px 60px -24px rgba(25,27,27,.32); }
  .card:hover::before{ opacity:1; }
  .card:hover::after{ opacity:1; }
  .card .ct-top{ display:flex; align-items:center; justify-content:space-between; }
  .card .ct-name{ font-family:"Space Grotesk",sans-serif; font-size:19px; font-weight:500; color:var(--ink); margin:0; }
  .card .ct-link{ font-size:12px; color:var(--faint); display:inline-flex; gap:6px; align-items:center; transition:color .3s; }
  .card:hover .ct-link{ color:var(--indigo); }
  .card .ct-desc{ color:var(--dim); font-size:14px; line-height:1.62; margin-top:14px; flex:1; }
  .card .ct-desc b{ color:var(--ink); font-weight:600; }
  .ct-desc code, .about-body code{ font-family:"Space Grotesk",ui-monospace,monospace; font-size:.86em; color:var(--indigo); background:rgba(94,83,227,.07); border:1px solid rgba(94,83,227,.16); border-radius:6px; padding:.06em .42em; letter-spacing:0; white-space:nowrap; }
  .card .tags{ display:flex; flex-wrap:wrap; gap:7px; margin-top:18px; }
  .tag{ font-family:"Space Grotesk",sans-serif; font-size:11px; color:var(--dim); border:1px solid var(--line);
    border-radius:99px; padding:3px 11px; letter-spacing:.02em; }
  .card.feat{ grid-column:span 2; min-height:auto; }
  .card.feat .ct-name{ font-size:22px; }
  /* ---- static inline-SVG technical banners (no per-frame JS, no animated filters/blurs) ---- */
  .card .vbanner{ display:block; width:calc(100% + 60px); margin:-30px -30px 20px; border-radius:20px 20px 0 0; background:var(--glass); border-bottom:1px solid var(--line-2); box-shadow:inset 0 -1px 0 rgba(255,255,255,.5); height:auto; transition:background .5s; }
  .card:hover .vbanner{ background:var(--glass-2); }
  .card.feat .vbanner{ margin:-30px -30px 22px; }
  .vbanner svg text{ font-family:"Space Mono",ui-monospace,monospace !important; }
  .varch{ display:block; width:100%; height:auto; margin:8px 0 28px; background:#fbfaf4; border-radius:16px; }
  @media (max-width:860px){ .varch{ margin:4px 0 20px; } }
  .repo-note{ text-align:center; margin-top:40px; color:var(--faint); font-size:13.5px; }
  .repo-note a{ color:var(--blue); background-image:linear-gradient(var(--blue),var(--blue));
    background-size:0% 1px; background-position:0 100%; background-repeat:no-repeat;
    transition:background-size .42s var(--ease-out), color .3s; }
  .repo-note a:hover, .repo-note a:focus-visible{ background-size:100% 1px; }

  /* ---------- capabilities (open cells + top-rules, rotating pastel index) ---------- */
  .cap-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:clamp(2px,1.2vw,22px); }
  .cap{ background:rgba(255,255,255,.5); padding:32px 28px 30px; border-radius:14px;
    border-top:2px solid var(--cap-acc,var(--line)); transition:background .4s, transform .4s var(--ease-out); }
  .cap:hover{ background:var(--bg-2); transform:translateY(-3px); }
  .cap:nth-child(1){ --cap-acc:var(--mint); } .cap:nth-child(2){ --cap-acc:var(--sky); }
  .cap:nth-child(3){ --cap-acc:var(--peri); } .cap:nth-child(4){ --cap-acc:var(--coral); }
  .cap:nth-child(5){ --cap-acc:var(--gold); } .cap:nth-child(6){ --cap-acc:var(--indigo); }
  .cap .ci{ font-family:"Space Grotesk",sans-serif; font-size:12px; color:var(--cap-acc,var(--indigo)); letter-spacing:.1em; filter:saturate(1.15) brightness(.82); }
  .cap .ch{ font-size:17px; font-weight:500; margin:12px 0 8px; color:var(--ink); }
  .cap .cl{ color:var(--dim); font-size:13.5px; line-height:1.65; }
  .cap .cl b{ color:var(--ink); font-weight:500; }

  /* ---------- contact ---------- */
  .contact-card{ border:1px solid var(--line); border-radius:28px; padding:clamp(40px,6vw,72px);
    background:var(--glass); box-shadow:var(--card-sh); text-align:center; position:relative; overflow:hidden; }
  .contact-card .glow{ position:absolute; width:420px; height:420px; border-radius:50%; top:-30%; left:50%; transform:translateX(-50%);
    background:radial-gradient(circle,rgba(94,83,227,.08),transparent 60%); pointer-events:none; }
  .contact-h{ font-family:"Fraunces",serif; font-optical-sizing:auto; font-weight:400; font-size:clamp(30px,5vw,58px); letter-spacing:-.03em; position:relative; color:var(--ink); }
  .contact-h .it{ font-style:italic; color:var(--indigo); -webkit-text-fill-color:var(--indigo); }
  .contact-card p{ color:var(--faint); margin:18px auto 34px; max-width:460px; position:relative; }
  .contact-card p a{ color:var(--blue); background-image:linear-gradient(var(--blue),var(--blue));
    background-size:0% 1px; background-position:0 100%; background-repeat:no-repeat;
    transition:background-size .42s var(--ease-out), color .3s; }
  .contact-card p a:hover, .contact-card p a:focus-visible{ background-size:100% 1px; }
  .contact-row{ display:flex; gap:14px; justify-content:center; flex-wrap:wrap; position:relative; }
  .clink{ display:inline-flex; align-items:center; gap:10px; border:1px solid var(--line); border-radius:99px;
    padding:13px 24px; font-size:14.5px; color:var(--ink);
    transition:background .35s, border-color .35s, color .35s, box-shadow .35s;
    transform:translate(var(--mtx,0px), calc(var(--mty,0px) + var(--lift,0px))); }
  .clink:hover{ --lift:-2px; will-change:transform; background:var(--ink); color:var(--on-ink); border-color:var(--ink); }

  /* ---------- footer ---------- */
  footer{ position:relative; z-index:1; background:var(--bg-2); border-top:1px solid var(--line);
    padding:40px max(28px,5vw); padding-bottom:max(40px, calc(env(safe-area-inset-bottom) + 20px));
    display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;
    color:var(--faint); font-size:13px; }
  footer .brand{ color:var(--ink); }

  /* ---------- reveal (refined: 22px + scale, expo-out, GPU-only) ---------- */
  .js .reveal{ opacity:0; transform:translate3d(0,22px,0) scale(.988);
    transition:opacity .85s var(--ease-out), transform .9s var(--ease-out); will-change:opacity,transform; }
  .reveal.in{ opacity:1; transform:none; will-change:auto; }
  .js .sec-head.reveal{ transform:translate3d(0,30px,0) scale(.99); }
  /* transient blur ONLY on .reveal — composites fine, guarded for reduced-transparency/-motion */
  @media not (prefers-reduced-transparency:reduce){
    .js .reveal{ filter:blur(6px); transition:opacity .85s var(--ease-out), transform .9s var(--ease-out), filter .8s var(--ease-out); }
    .reveal.in{ filter:blur(0); }
  }
  /* title / lead clip-path wipe; eyebrow x-drift (hero owns its own delays) */
  .js .sec-title.reveal, .js .about-lead.reveal, .js .contact-h.reveal{ clip-path:inset(0 0 18% 0); }
  .sec-title.reveal.in, .about-lead.reveal.in, .contact-h.reveal.in{ clip-path:inset(0 0 0 0); transition:opacity .85s var(--ease-out), transform .9s var(--ease-out), clip-path .9s var(--ease-out), filter .8s var(--ease-out); }
  .js .eyebrow.reveal{ transform:translate3d(-14px,0,0); }
  .eyebrow.reveal.in{ transform:none; }
  /* hero-scoped authored stagger (curtain/hero IIFE owns these) */
  .hero .reveal.d1{ transition-delay:.08s; } .hero .reveal.d2{ transition-delay:.16s; } .hero .reveal.d3{ transition-delay:.24s; }
  @media (prefers-reduced-motion:reduce){
    .js .reveal{ transform:none!important; clip-path:none!important; filter:none!important; transition:opacity .4s ease; }
  }

  /* ---------- background-clip fallback (legacy guard; no clipped serif remains) ---------- */
  @supports not ((-webkit-background-clip:text) or (background-clip:text)){
    .hero h1 .en, .stat .n{ -webkit-text-fill-color:currentColor; color:var(--ink); background:none; }
  }

  /* ---------- touch: kill sticky hover ---------- */
  @media (hover:none),(pointer:coarse){
    .card:hover{ transform:none; }
    .card::after,.card::before{ display:none; }
    .card:active{ background:var(--glass-2); }
  }

  /* ---------- reduced transparency ---------- */
  @media (prefers-reduced-transparency: reduce){
    nav.scrolled{ background:#f4f2ea; backdrop-filter:none; -webkit-backdrop-filter:none; }
    .content{ background:#fbfaf4; backdrop-filter:none; -webkit-backdrop-filter:none; }
    .card{ background:#fffdf6; } .contact-card{ background:#fffdf6; }
    .stat,.cap{ background:#fffdf6; }
    .nav-links.open{ background:#fbfaf4; backdrop-filter:none; }
  }

  @media (max-width:860px){
    .hero .wrap{ max-width:100%; }
    .about-grid{ grid-template-columns:1fr; gap:36px; }
    .about-lead{ max-width:100%; }
    .work-grid{ grid-template-columns:1fr; }
    .card.feat{ grid-column:span 1; }
    .cap-grid{ grid-template-columns:1fr; gap:14px; }
    .hero h1{ font-size:clamp(42px,11.5vw,84px); line-height:.94; }
    /* vertical cream wash instead of the 100deg horizontal fade (full-width mobile text) */
    header.hero::before{ background:linear-gradient(180deg, rgba(251,250,244,.10) 0%, rgba(251,250,244,.50) 55%, rgba(251,250,244,.80) 100%); }
  }
  @media (max-width:430px){
    .hero h1{ font-size:clamp(36px,12vw,56px); line-height:.96; }
    .id-line{ font-size:10px; letter-spacing:.16em; }
    .hero .sub{ max-width:100%; font-size:11px; }
    section.panel{ padding:clamp(64px,16vw,96px) 0; }
    .sec-head{ gap:10px; margin-bottom:38px; }
  }
  @media (prefers-reduced-motion:reduce){ *{ animation:none !important; } .reveal{ transition:opacity .4s; transform:none; } #intro{ display:none; } }
  /* ================= hud-typography: global type retokens (cascade-wins over legacy rules) ================= */
  .skip{ font-family:var(--font-mono); text-transform:uppercase; letter-spacing:.08em; font-size:12px; }
  .hero .eyebrow{ font-family:var(--font-mono); }
  .hero h1{ font-family:var(--font-display); font-weight:900; text-transform:uppercase; letter-spacing:-.02em; line-height:.92; }
  .hero h1 .en{ font-weight:900; }
  .hero .role{ font-family:var(--font-mono); font-size:clamp(13px,1.7vw,17px); letter-spacing:.12em; text-transform:uppercase; }
  .hero .role b{ font-weight:700; }
  .scroll-hint{ font-family:var(--font-mono); left:50%; transform:translateX(-50%);
    bottom:max(52px, calc(env(safe-area-inset-bottom) + 40px)); }
  .sec-num{ font-family:var(--font-mono); font-weight:700; letter-spacing:.18em; color:var(--ink);
    background:var(--lime); padding:3px 9px 2px; display:inline-block; }
  .sec-title{ font-family:var(--font-display); font-weight:900; text-transform:uppercase; letter-spacing:-.02em; line-height:.92; }
  .about-lead{ font-family:var(--font-display); font-weight:700; letter-spacing:-.015em; line-height:1.18; }
  .about-lead .hl{ font-style:normal; }
  .about-grid dt{ font-family:var(--font-mono) !important; }
  .stat .n{ font-family:var(--font-display); font-weight:900; letter-spacing:-.02em; }
  .stat .l{ font-family:var(--font-mono); font-size:10.5px; letter-spacing:.08em; text-transform:uppercase; }
  .card .ct-name{ font-family:var(--font-mono); font-weight:700; font-size:15px; letter-spacing:.08em; text-transform:uppercase; }
  .card.feat .ct-name{ font-size:17px; }
  .card .ct-link{ font-family:var(--font-mono); font-size:10.5px; letter-spacing:.1em; text-transform:uppercase; }
  .ct-desc code, .about-body code{ font-family:var(--font-mono); }
  .tag{ font-family:var(--font-mono); font-size:10px; letter-spacing:.1em; text-transform:uppercase; border-radius:0; }
  .vbanner svg text, .varch text{ font-family:var(--font-mono) !important; }
  .cap .ci{ font-family:var(--font-mono); font-weight:700; letter-spacing:.14em; }
  .cap .ch{ font-family:var(--font-mono); font-weight:700; text-transform:uppercase; letter-spacing:.06em; font-size:14px; }
  .contact-h{ font-family:var(--font-display); font-weight:900; text-transform:uppercase; letter-spacing:-.02em; line-height:.95; }
  .contact-h .it{ font-style:normal; }
  .btn, .clink{ font-family:var(--font-mono); text-transform:uppercase; letter-spacing:.1em; font-weight:700; font-size:12.5px; }
  .repo-note{ font-family:var(--font-mono); font-size:11.5px; letter-spacing:.06em; text-transform:uppercase; }
  footer{ font-family:var(--font-mono); font-size:11px; letter-spacing:.1em; text-transform:uppercase;
    padding-bottom:max(72px, calc(env(safe-area-inset-bottom) + 48px)); }
</style>
</head>
<body>
<a href="#main" class="skip">Skip to content</a>

<div id="intro" aria-hidden="true">
  <span class="iwords"><span class="il">GAN LIN</span></span>
  <span class="irule"></span>
</div>

<canvas id="gl" aria-hidden="true"></canvas>
<div class="noise-fix" aria-hidden="true"></div>
<div class="cur" aria-hidden="true"></div><div class="cur-d" aria-hidden="true"></div>

<nav id="nav" aria-label="Primary">
  <a href="#top" class="brand"><span class="dot" aria-hidden="true"></span><b>GAN&nbsp;LIN</b><span class="role-tag">— AI/AGENT ENGINEER</span></a>
  <div class="nav-links" id="navlinks">
    <a href="#work">Work</a>
    <a href="#about">About</a>
    <a href="#contact">Contact</a>
    <a href="https://github.com/ganlin770" target="_blank" rel="noopener" class="nav-cta">GitHub<span class="brk" aria-hidden="true">[↗]</span><span class="vh">(opens in new tab)</span></a>
  </div>
  <button type="button" class="burger" id="burger" aria-label="Open menu" aria-controls="navlinks" aria-expanded="false"><span></span><span></span><span></span></button>
</nav>
<div id="sprog" aria-hidden="true"></div>
<!-- HUD: fixed bottom rail (clock / cursor coords / globe glyph) + plotter frame -->
<div class="hud-rail" aria-hidden="true">
  <span class="hud-cell">GMT+8 CN <span id="hudclock">--:--</span></span>
  <span class="hud-cell hud-xy" id="hudxy">0000 X 0000 Y</span>
  <span class="hud-cell hud-globe"><svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><circle cx="8" cy="8" r="6.5"/><ellipse cx="8" cy="8" rx="3" ry="6.5"/><line x1="1.5" y1="8" x2="14.5" y2="8"/><path d="M2.6 4.5 h10.8 M2.6 11.5 h10.8"/></svg></span>
</div>
<div class="hud-frame" aria-hidden="true">
  <i class="hud-col hud-col-l"></i><i class="hud-col hud-col-r"></i>
  <b class="hud-x" style="left:var(--hud-col-l);top:18vh"></b>
  <b class="hud-x" style="left:var(--hud-col-l);top:50vh"></b>
  <b class="hud-x" style="left:var(--hud-col-l);top:82vh"></b>
  <b class="hud-x" style="left:var(--hud-col-r);top:18vh"></b>
  <b class="hud-x" style="left:var(--hud-col-r);top:50vh"></b>
  <b class="hud-x" style="left:var(--hud-col-r);top:82vh"></b>
</div>

<header class="hero" id="top">
  <div class="hero-top">
    <p class="tagline reveal">Thinking in evals.<br />Shipping in loops.</p>
    <p class="sub reveal d1">I'm Gan Lin — building open-source agent tooling: eval frameworks, fine-tuned tool routers, MCP servers. Outside that I run English dev content across TikTok / X / IG.</p>
  </div>
  <div class="wrap">
    <p class="id-line reveal">Gan Lin — AI / Agent Engineer × Technical Operator</p>
    <h1 class="reveal d1"><span class="hl-ln">I ship agent tools</span><span class="hl-ln">&amp; the content</span><span class="hl-ln">developers trust.</span></h1>
    <div class="cta-row reveal d2">
      <a href="#work" class="btn solid mag">View Work <span class="arr" aria-hidden="true">↘</span></a>
      <a href="https://github.com/ganlin770" target="_blank" rel="noopener" class="btn ghost mag">Browse the Code <span class="arr" aria-hidden="true">↗</span><span class="vh">(opens in new tab)</span></a>
    </div>
  </div>
  <div class="stk stk-lime" aria-hidden="true">Open-Source&nbsp;✳</div>
  <div class="stk stk-ink" aria-hidden="true">EVAL&nbsp;4.1%&nbsp;→&nbsp;74.2%</div>
  <div class="stk stk-arrow" aria-hidden="true"><svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"><path d="M6 4h10v10h10v10h10v12H24V26H14V16H6z" fill="#c0fe04" stroke="#191b1b" stroke-width="2" stroke-linejoin="miter"/></svg></div>
  <div class="scroll-hint" aria-hidden="true"><span>Scroll</span><span class="line"></span></div>
</header>

<main id="main" class="content" tabindex="-1">

  <!-- INTRO STATEMENT -->
  <section class="panel statement" id="statement" aria-label="Currently building">
    <div class="wrap">
      <p class="stmt reveal">I'm building <a class="stmt-link" href="https://github.com/ganlin770/promptlab" target="_blank" rel="noopener">promptlab<span class="vh"> (opens in new tab)</span></a>, <a class="stmt-link" href="https://github.com/ganlin770/tool-smith" target="_blank" rel="noopener">tool-smith<span class="vh"> (opens in new tab)</span></a> and <a class="stmt-link" href="https://github.com/ganlin770" target="_blank" rel="noopener">20+ MCP servers<span class="vh"> (opens in new tab)</span></a> — all open-source, all reproducible.</p>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="panel" id="about" aria-labelledby="about-h">
    <div class="wrap">
      <div class="sec-head reveal"><span class="sec-num" aria-hidden="true">01</span><h2 id="about-h" class="sec-title">About</h2></div>
      <div class="reveal"><svg class="varch" viewBox="0 0 840 220" role="img" aria-labelledby="aa-t aa-d" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet"><title id="aa-t">Engineered agent loop architecture</title><desc id="aa-d">An agent loop: a tool call is validated; on success it returns, on failure it routes to an auto-repair retry that loops back, and after exhausted retries it falls back to a frontier model. Every step writes to a JSONL log and monitoring sink.</desc><rect x="0.75" y="0.75" width="838.5" height="218.5" rx="16" fill="#fbfaf4" stroke="#191b1b" stroke-opacity=".12"/><line x1="28" y1="40" x2="812" y2="40" stroke="#191b1b" stroke-opacity=".10"/><g font-family="'Space Grotesk',ui-monospace,monospace" fill="#767972"><text x="28" y="30" font-size="11.5" letter-spacing="2">ENGINEERED AGENT LOOP</text><text x="812" y="30" font-size="10.5" text-anchor="end" letter-spacing="1.5">validate · repair · fallback · log</text></g><g font-family="'Space Grotesk',monospace"><g transform="translate(28 78)"><rect x="0.75" y="0.75" width="118.5" height="48.5" rx="11" fill="#afb6ff" fill-opacity=".14" stroke="#5e53e3" stroke-opacity=".55" stroke-width="1.5"/><text x="60" y="22" text-anchor="middle" font-size="12" fill="#191b1b" font-weight="600">tool call</text><text x="60" y="37" text-anchor="middle" font-size="8.5" fill="#5e53e3">agent action</text></g><g transform="translate(214 102)"><path d="M 0 0 L 42 -36 L 84 0 L 42 36 Z" fill="#8dcbff" fill-opacity=".14" stroke="#0077bc" stroke-opacity=".55" stroke-width="1.5"/><text x="42" y="-2" text-anchor="middle" font-size="11" fill="#191b1b" font-weight="600">validate</text><text x="42" y="11" text-anchor="middle" font-size="8" fill="#0077bc">output ok?</text></g><g transform="translate(360 78)"><rect x="0.75" y="0.75" width="118.5" height="48.5" rx="11" fill="#80daac" fill-opacity=".16" stroke="#00784a" stroke-opacity=".55" stroke-width="1.5"/><text x="60" y="22" text-anchor="middle" font-size="12" fill="#191b1b" font-weight="600">return ✓</text><text x="60" y="37" text-anchor="middle" font-size="8.5" fill="#00784a">validated result</text></g><g transform="translate(360 150)"><rect x="0.75" y="0.75" width="118.5" height="44.5" rx="11" fill="#ebc669" fill-opacity=".20" stroke="#191b1b" stroke-opacity=".4" stroke-width="1.5"/><text x="60" y="20" text-anchor="middle" font-size="11" fill="#191b1b" font-weight="600">repair-retry</text><text x="60" y="34" text-anchor="middle" font-size="8" fill="#5f625c">auto-fix · re-run</text></g><g transform="translate(560 150)"><rect x="0.75" y="0.75" width="128.5" height="44.5" rx="11" fill="#ffa3a3" fill-opacity=".18" stroke="#c0434c" stroke-opacity=".5" stroke-width="1.5"/><text x="65" y="20" text-anchor="middle" font-size="11" fill="#191b1b" font-weight="600">frontier fallback</text><text x="65" y="34" text-anchor="middle" font-size="8" fill="#c0434c">retries exhausted</text></g><g transform="translate(560 60)"><rect x="0.75" y="0.75" width="250.5" height="64.5" rx="11" fill="#5e53e3" fill-opacity=".07" stroke="#5e53e3" stroke-opacity=".4" stroke-width="1.5"/><text x="16" y="24" font-size="11.5" fill="#191b1b" font-weight="600">JSONL log + monitor</text><g stroke="#5e53e3" stroke-opacity=".55" stroke-width="1.5"><line x1="16" y1="38" x2="150" y2="38"/><line x1="16" y1="46" x2="170" y2="46"/><line x1="16" y1="54" x2="120" y2="54"/></g><text x="234" y="56" text-anchor="end" font-size="8" fill="#5e53e3">every step →</text></g></g><g stroke="#191b1b" stroke-width="1.5" fill="none"><g stroke-opacity=".45"><path d="M 148 102 H 212"/><path d="M 206 97 L 212 102 L 206 107"/></g><g stroke-opacity=".45"><path d="M 298 96 C 330 90 332 102 358 102"/><path d="M 352 97 L 358 102 L 352 107"/></g><g stroke-opacity=".45"><path d="M 298 122 C 330 134 332 172 358 172"/><path d="M 352 167 L 358 172 L 352 177"/></g><g stroke="#ebc669" stroke-opacity=".8"><path d="M 360 188 C 200 210 70 196 70 132"/><path d="M 65 138 L 70 131 L 75 138"/></g><g stroke-opacity=".45"><path d="M 480 172 H 558"/><path d="M 552 167 L 558 172 L 552 177"/></g><g stroke-opacity=".3" stroke-dasharray="3 4"><path d="M 624 148 C 624 110 540 104 480 102"/><path d="M 486 97 L 480 102 L 486 107"/></g></g><g font-family="'Space Grotesk',monospace" font-size="8.5"><text x="322" y="88" fill="#00784a">pass</text><text x="318" y="150" fill="#c0434c">fail</text><text x="150" y="160" fill="#ebc669">retry loop</text></g><g stroke="#5e53e3" stroke-opacity=".22" stroke-width="1.2" stroke-dasharray="2 4" fill="none"><path d="M 88 78 V 60 H 560"/><path d="M 419 78 V 70"/><path d="M 419 150 V 132 H 560"/><path d="M 625 150 V 126"/></g></svg></div>
      <div class="about-grid">
        <div>
          <p class="about-lead reveal">Self-taught AI engineer, class of 2026 — working the rare seam between <span class="hl">shipping agent tools</span> and <span class="hl">building the developer audience</span> around them.</p>
          <div class="about-body" style="margin-top:34px;">
            <p class="reveal d1">I write LLM eval frameworks from scratch (rule × LLM-as-judge, CI gates, JSONL audit), fine-tune small models into tool-calling routers with PEFT/TRL, and build full-stack apps with Claude Code, Cursor &amp; Codex — then run English dev content across TikTok / X / IG. Because I ship the tools myself, the developer content I make actually holds technical weight.</p>
          </div>
        </div>
        <div class="reveal d1">
          <div class="stats">
            <div class="stat"><div class="n">70+</div><div class="l">Claude Code Skills</div></div>
            <div class="stat"><div class="n">20+</div><div class="l">MCP Servers</div></div>
            <div class="stat"><div class="n">5</div><div class="l">Open-source projects</div></div>
            <div class="stat"><div class="n">100%</div><div class="l">Open-source &amp; reproducible</div></div>
          </div>
          <dl style="margin-top:24px;display:grid;grid-template-columns:auto 1fr;column-gap:18px;row-gap:14px;font-size:13.5px;line-height:1.5;">
            <dt style="font-family:'Space Grotesk',sans-serif;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--label);padding-top:2px;">Focus</dt>
            <dd style="color:var(--dim);margin:0;">LLM eval &amp; reliability · Agent / MCP engineering · applied model fine-tuning (PEFT/LoRA) · full-stack &amp; deploy.
              </dd>

            <dt style="font-family:'Space Grotesk',sans-serif;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--label);padding-top:2px;">Stack</dt>
            <dd style="color:var(--dim);margin:0;">Python / FastAPI · Node / TypeScript · React / Next.js · Claude Code · Cursor · Codex · Vercel / Zeabur.</dd>

            <dt style="font-family:'Space Grotesk',sans-serif;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--label);padding-top:2px;">Build</dt>
            <dd style="color:var(--dim);margin:0;"><b style="color:var(--ink);font-weight:500;">promptlab</b> · <b style="color:var(--ink);font-weight:500;">tool-smith</b> · <b style="color:var(--ink);font-weight:500;">thesis-generator</b> · <b style="color:var(--ink);font-weight:500;">matlab-viz-mcp</b> · <b style="color:var(--ink);font-weight:500;">paper-search-server</b> — from idea to production.
              </dd>

            <dt style="font-family:'Space Grotesk',sans-serif;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--label);padding-top:2px;">Open</dt>
            <dd style="color:var(--dim);margin:0;">Everything open-source &amp; reproducible at <span style="color:var(--ink);">github.com/ganlin770</span>. English is a working language.
              </dd>
          </dl>
        </div>
      </div>
    </div>
  </section>

